[Unit]
Description=T40 hardware watchdog (reset board when userspace/bridge wedges)
Documentation=file:/root/hw_wdt.py
# 不依赖 t40-link.service：最常见的楔死就发生在 start_all 里（insmod ath6kl 卡 D 状态），
# 那时候 autostart 和桥接都还没起来，只有这条能救。
After=local-fs.target
Before=t40-link.service
# 看门狗要尽早起：给 start_all 留出 300 s 启动窗口由 hw_wdt.py 自己的 --grace 控制
DefaultDependencies=no

[Service]
Type=simple
# 用默认的 KillMode=control-group：stop/restart 时把 python 子进程一起收掉，
# 否则 restart 只杀外壳、旧的 hw_wdt.py 留在 cgroup 里继续喂狗，
# 新的那份就永远起不来（踩过）。正常运行时 systemd 不会动它，
# 停止服务=解除保护，这正是我们想要的语义。
TimeoutStopSec=10
ExecStart=/bin/sh /root/40-hw-wdt.sh
# on-failure 而不是 always：外壳在"已解除保护"（/root/hw_wdt.disarmed）时会 exit 0，
# 用 always 会每 3 秒拉起一次、无限刷日志。
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
